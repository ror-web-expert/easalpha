{
  "name": "easalpha-desktop",
  "version": "0.2.0",
  "description": "EasAlpha POS desktop shell: wraps the web POS and adds ESC/POS printing and the LAN print server",
  "main": "dist/main.js",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "license": "UNLICENSED",
  "author": "EasAlpha",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "pnpm run build && electron .",
    "test": "pnpm run build && node --test dist/*.test.js",
    "dist": "pnpm run build && electron-builder",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:dir": "pnpm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.easalpha.pos",
    "productName": "EasAlpha POS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.test.js",
      "ui/**/*",
      "build/icon.png",
      "package.json"
    ],
    "icon": "build/icon.png",
    "publish": {
      "provider": "generic",
      "url": "https://updates.easalpha.com/desktop"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "EasAlpha POS"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "EasAlpha <support@easalpha.com>"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business"
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "homepage": "https://easalpha.com",
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
