# Copy to deploy/.env and fill in. Used by deploy/docker-compose.yml. The server copy lives at ~/easalpha/.env.
# Comments go on their own line, never after a value: Docker Compose reads "NAME=   # text" as the value "# text"
# (26 Nov 2026: SENTRY_DSN held its own comment and the API would not start; PADDLE_WEBHOOK_SECRET held a public string).
# Where the web app is served (also used for CORS, mail links and push links)
PUBLIC_URL=https://easalpha.com
# Where the API is served (the web app calls it from the browser)
API_PUBLIC_URL=https://api.easalpha.com
POSTGRES_PASSWORD=change-me
# easalpha-api/config/master.key
RAILS_MASTER_KEY=
# Set it (openssl rand -hex 24) and the API connects as the easalpha_app role: Row-Level Security applies. Unset in
# production: a WARNING at every start and "rls":false on /api/v1/health (docs/DEPLOY.md, "Row-Level Security")
EASALPHA_APP_DB_PASSWORD=
# Paddle > Notifications > the webhook's secret; the API refuses Paddle events until it is set
PADDLE_WEBHOOK_SECRET=
# Optional: errors go to Sentry (sentry.io project DSN); blank = off
SENTRY_DSN=
# Nightly backups (the "backup" service): folder on the server, days kept, time (server clock), optional copy-off command
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_AT=03:30
# Runs inside the backup container (postgres:16: no rclone, rsync, ssh or curl), so it cannot copy off the server; use
# the host cron in docs/DEPLOY.md ("Backup") for that
BACKUP_COPY_CMD=
# false only on a plain-HTTP LAN install behind no proxy
FORCE_SSL=true
# Shared secret between the API and the WhatsApp gateway
WHATSAPP_GATEWAY_TOKEN=change-me
# First super admin (/super), created on first start if missing
SUPER_ADMIN_EMAIL=owner@easalpha.com
SUPER_ADMIN_PASSWORD=change-me

# Self-hosted analytics (Umami at https://<PUBLIC_URL>/stats). APP_SECRET: openssl rand -hex 32. ANALYTICS_ID is the website
# id Umami shows after the website is added (docs/DEPLOY.md, "Analytics"); the site loads no tracker until it is set.
UMAMI_APP_SECRET=change-me
ANALYTICS_PROVIDER=umami
ANALYTICS_SRC=/stats/script.js
ANALYTICS_ID=
# Umami's own login at /stats (user admin). Umami starts with admin / umami: change it at the first login (anyone can
# reach /stats) and keep the new one here, where nothing reads it but you.
UMAMI_ADMIN_PASSWORD=

# Which compose files to use. Production (since 26 Nov 2026: a VM nothing on the internet reaches; prebuilt images,
# a Cloudflare Tunnel brings the traffic in to Caddy in this stack, no port published):
COMPOSE_FILE=docker-compose.yml:docker-compose.images.yml:docker-compose.tunnel.yml
# A server with its own public address, Caddy in this stack on 80/443 with Let's Encrypt:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.images.yml:docker-compose.caddy.yml
# A server where another Caddy already runs in Docker and holds 80/443 (the shared server until Nov 2026):
#   COMPOSE_FILE=docker-compose.yml:docker-compose.images.yml:docker-compose.proxy.yml   and PROXY_NETWORK below
# Build on this machine instead and publish ports 3000/3001 yourself: COMPOSE_FILE=docker-compose.yml
# Prebuilt images (docker-compose.images.yml). The deploy workflow rewrites these two lines on every deploy.
IMAGE_REPO=ghcr.io/your-github-user/easalpha
IMAGE_TAG=latest
# Cloudflare Tunnel (docker-compose.tunnel.yml): the token Cloudflare shows when the tunnel is made (Zero Trust,
# Networks, Tunnels; the long value after "--token"). docs/DEPLOY.md, "Cloudflare Tunnel".
TUNNEL_TOKEN=
# Docker network of the other TLS proxy (docker-compose.proxy.yml only; docker-compose.caddy.yml does not read it)
PROXY_NETWORK=kamal

# Optional: Meta WhatsApp Cloud API (provider "cloud"); leave blank when linking a phone by QR
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any long random string, pasted into Meta's webhook setup; unset = the verify endpoint answers 403
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional: fixed Web Push keys (generated and stored automatically when blank)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@easalpha.com

# Outgoing email (welcome email at signup, scheduled reports, later invoices and password resets). Any SMTP provider:
# Resend (smtp.resend.com, user "resend", password = API key), Postmark, Brevo, Amazon SES. Blank = no mail is sent.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
MAIL_FROM=EasAlpha <no-reply@easalpha.com>
SUPPORT_EMAIL=hello@easalpha.com
