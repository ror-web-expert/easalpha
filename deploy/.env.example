# Copy to deploy/.env and fill in. Used by deploy/docker-compose.yml. The server copy lives at ~/easalpha/.env.
PUBLIC_URL=https://easalpha.com                # where the web app is served (also used for CORS, mail links and push links)
API_PUBLIC_URL=https://api.easalpha.com        # where the API is served (the web app calls it from the browser)
POSTGRES_PASSWORD=change-me
RAILS_MASTER_KEY=                              # easalpha-api/config/master.key
FORCE_SSL=true                                 # false only on a plain-HTTP LAN install behind no proxy
WHATSAPP_GATEWAY_TOKEN=change-me               # shared secret between the API and the WhatsApp gateway
SUPER_ADMIN_EMAIL=owner@easalpha.com           # first super admin (/super), created on first start if missing
SUPER_ADMIN_PASSWORD=change-me

# Which compose files to use. Production server (prebuilt images, Caddy already in Docker):
COMPOSE_FILE=docker-compose.yml:docker-compose.images.yml:docker-compose.proxy.yml
# Build on this machine instead and publish ports 3000/3001 yourself: COMPOSE_FILE=docker-compose.yml
# Prebuilt images (docker-compose.images.yml). The deploy workflow rewrites these two lines on every deploy.
IMAGE_REPO=ghcr.io/your-github-user/easalpha
IMAGE_TAG=latest
# Docker network of the TLS proxy (docker-compose.proxy.yml)
PROXY_NETWORK=kamal

# Optional: Meta WhatsApp Cloud API (provider "cloud"); leave blank when linking a phone by QR
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional: fixed Web Push keys (generated and stored automatically when blank)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@easalpha.com

# Outgoing email (welcome email at signup, scheduled reports, later invoices and password resets). Any SMTP provider:
# Resend (smtp.resend.com, user "resend", password = API key), Postmark, Brevo, Amazon SES. Blank = no mail is sent.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
MAIL_FROM=EasAlpha <no-reply@easalpha.com>
SUPPORT_EMAIL=hello@easalpha.com
