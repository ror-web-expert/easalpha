# EasAlpha on a server of its own: this Caddy runs in the compose stack (docker-compose.caddy.yml), holds ports 80 and
# 443, gets the Let's Encrypt certificates itself (kept in the caddy_data volume) and reaches the web and api services
# by name. The deploy copies this folder to the server; the deploy job reloads Caddy after every "up", so a change here
# needs only a push. By hand: docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
# (A server where someone else's Caddy already holds 80/443: docker-compose.proxy.yml and Caddyfile.easalpha instead.)
{
	servers {
		# easalpha.com is proxied by Cloudflare (orange cloud), so every request reaches Caddy from a Cloudflare
		# address and the customer's own address arrives in CF-Connecting-IP. That header is believed only from these
		# ranges (https://www.cloudflare.com/ips, 26 Nov 2026); from anywhere else the connection's own address is used,
		# so nobody can choose their address by sending the header straight to the server.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# The API's rate limits (Rack::Attack), audit log and sign-in records read the client address from X-Forwarded-For.
# Caddy's own X-Forwarded-For would end in the Cloudflare address, so every shop behind the same Cloudflare city
# would share one login and pairing limit; {client_ip} is the customer's address worked out above.
(upstream_headers) {
	header_up X-Forwarded-For {client_ip}
}

easalpha.com, www.easalpha.com {
	encode zstd gzip
	reverse_proxy web:3000 {
		import upstream_headers
	}
}

api.easalpha.com {
	encode zstd gzip
	# The largest legitimate body is a 5 MB image upload or a 200-record sync batch; anything bigger is dropped here,
	# before it reaches Puma (6 Nov 2026 review, A15).
	request_body {
		max_size 25MB
	}
	reverse_proxy api:3001 {
		import upstream_headers
	}
}
